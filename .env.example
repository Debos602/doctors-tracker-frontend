# Express API (see ../backend). Called from the browser with the user's access token.
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# NEXT_PUBLIC_API_URL=https://doctors-tracker-backend.vercel.app/api

# Optional server-only URL for the same API, used by NextAuth for login/refresh
# (e.g. an internal Docker hostname). Defaults to NEXT_PUBLIC_API_URL.
API_URL=

# NextAuth
NEXTAUTH_URL=https://doctor-tracker-frontend-steel.vercel.app
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=KMzS5WUDzdOy9+9B8GAK6dGMpD8GHaNOz9LI7s8Ns3k=

# Show the "Use demo account" helper on the login page (matches the backend seed admin)
NEXT_PUBLIC_DEMO_EMAIL=admin@doctortracker.com
NEXT_PUBLIC_DEMO_PASSWORD=Admin@12345
